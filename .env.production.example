# ================================================================
# AgentX / WhatsCRM SaaS - Variáveis de Ambiente para Produção (VPS)
# Copie este arquivo para .env no servidor: cp .env.production.example .env
# ================================================================

# Porta da aplicação (padrão: 3000)
PORT=3000

# Ambiente de execução (obrigatoriamente production na VPS)
NODE_ENV=production

# ----------------------------------------------------------------
# Supabase Configuration
# Obtenha em: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
# ----------------------------------------------------------------
# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://xhnxhfhmplstqiavswgo.supabase.co
SUPABASE_URL=https://xhnxhfhmplstqiavswgo.supabase.co

# Chave Anon / Pública (usada pelo Frontend)
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Chave Service Role / Secreta (usada pelo Backend para gerenciar sessões e banco)
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui
SUPABASE_SERVICE_KEY=sua_chave_service_role_aqui

# ----------------------------------------------------------------
# Inteligência Artificial (Google Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui

# Chave de criptografia simétrica AES-256 para salvar chaves dos clientes com segurança
# Deve conter exatamente 32 caracteres (exemplo gerado aleatório):
ENCRYPTION_KEY=sua_chave_secreta_com_32_chars!

# ----------------------------------------------------------------
# Configuração de Domínio e URLs Públicas
# ----------------------------------------------------------------
# URL pública do seu SaaS (com https:// e sem barra final)
VITE_API_URL=https://seudominio.com

# Email do Administrador Principal (Super Admin)
ADMIN_EMAIL=admin@seudominio.com

# ----------------------------------------------------------------
# Flags Opcionais de Diagnóstico
# ----------------------------------------------------------------
# DISABLE_SCHEDULER=true          # Desativa o agendador de mensagens/lembretes (caso queira isolar)
# DISABLE_WHATSAPP_RECONNECT=true  # Impede reconexão automática das sessões ao ligar o servidor

